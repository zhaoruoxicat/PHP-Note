Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^(?:index\.php/)?login/v2(?:/poll|/flow/[a-f0-9]{64})?/?$ NextcloudAPI/index.php [QSA,L]
RewriteRule ^(?:NextcloudAPI/)?status\.php$ NextcloudAPI/index.php [QSA,L]
RewriteRule ^(?:index\.php/)?apps/notes/api/v(?:1|0\.2)/(?:notes(?:/[1-9][0-9]*)?|settings)/?$ NextcloudAPI/index.php [QSA,L]
RewriteRule ^ocs/v[12]\.php/cloud/capabilities/?$ NextcloudAPI/index.php [QSA,L]
RewriteRule ^NextcloudAPI/(?!index\.php$|$).*$ - [F,L]
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
RewriteRule ^(?:app|config|database|storage|scripts|tests|docs|deploy|\.git|\.agents|\.codex|\.aws)(?:/|$) - [F,L,NC]
RewriteRule ^.*\.(?:md|sql|log|ini|env)$ - [F,L,NC]
RewriteRule ^([0-9]{6})/?$ anonymous.php?code=$1 [QSA,L]
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "DENY"
</IfModule>
